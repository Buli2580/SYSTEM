{
  "build": {
    "device-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "developmentClient": false,
      "channel": "preview"
    },
    "play-internal": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "preview",
      "developmentClient": false,
      "autoIncrement": true
    }
  },
  "cli": {
    "appVersionSource": "remote"
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
